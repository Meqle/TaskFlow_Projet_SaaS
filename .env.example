# Adresse complète de la base MongoDB (topologie et options de lecture/écriture)
# Partie 1 (serveur unique) : mongodb://mongo:27017/taskflow
# Partie 2 (replica set)    : mongodb://mongo1:27017,mongo2:27017,mongo3:27017/taskflow?replicaSet=rs0&w=majority&readPreference=primaryPreferred
# Partie 2 (cluster shardé) : mongodb://mongos1:27017,mongos2:27017/taskflow?w=majority&readPreference=primaryPreferred
MONGO_URI=mongodb://mongo:27017/taskflow

# Port d'écoute du serveur HTTP
PORT=3000

# Signature des jetons JWT (cookie httpOnly)
JWT_SECRET=7f8a9b2c4d6e1f3a5b7c9d0e2f4a6b8c1d3e5f7a9b0c2d4e6f8a1b3c5d7e9f0a
JWT_EXPIRES_IN=8h

# Initialisation automatique des données de démonstration si la base est vide
SEED_ON_START=true

# Compte super-admin plateforme créé au premier démarrage
ADMIN_EMAIL=admin@taskflow.local
ADMIN_PASSWORD=admin123

